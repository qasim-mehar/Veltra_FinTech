# PostgreSQL connection used by the Prisma CLI, client, seed, and verify scripts.
# Locally this matches docker-compose.yml (postgres:16 on localhost:5432).
DATABASE_URL="postgresql://user:password@localhost:5432/veltra"
# Direct (non-pooled) connection for migrations/schema pushes. Equal to
# DATABASE_URL for local Postgres and Docker; differs only on Neon (pooled vs direct).
DIRECT_URL="postgresql://user:password@localhost:5432/veltra"
# Super admin username. The seed creates the admin if this username does not exist.
ADMIN_USERNAME="admin"
# Super admin password, read only at seed time, hashed with bcrypt cost 12.
# Never printed, never logged, and never committed (.env is gitignored).
ADMIN_PASSWORD="change-me-now"
# Shared secret that later milestones use to authenticate the cron endpoint.
# Generate a long random string, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`.
CRON_SECRET="generate-a-long-random-string"
# Public origin used in later milestones to build absolute links in notifications/emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
